# 复制到 /etc/gok-share.env（chmod 600），或者用 --env-from-file 喂给 pm2。
#
# 两把密钥都用下面这条生成，各生成一次，别把同一个值填两处（程序会拒绝启动）：
#   openssl rand -hex 32
#
# 存好后请把这份文件和数据库备份分开存放：盐和 db 一起泄露，
# 加盐哈希就白做了（QQ 空间在 GPU 上是分钟级的事）。

GOK_SALT=
GOK_ADMIN_SECRET=

# 监听地址。**留空 = 所有网卡**：服务端会绑双栈地址，IPv4 和 IPv6 都能连，放行防火墙端口即可。
# 想只给本机/反代用就设 127.0.0.1（那时它会自动开始信任 X-Forwarded-For）。
# ⚠️ 别填 0.0.0.0 —— 那**只开 IPv4**，纯 v6 的机器或从 v6 过来的请求一个字节都进不来，
#    而 ss 看起来「明明在监听」，很难查。真要只监听某块网卡就填它的具体 IPv4 地址。
#GOK_HOST=

#GOK_PORT=8787

# SQLite 文件位置，默认 ./data/share.db（相对本目录）
#GOK_DB=

# 是否信任 X-Forwarded-For。
# 不设的话：监听回环 = 信任（反代场景），监听 0.0.0.0 = 不信任（防伪造）。
# 只有在自动判断不符合你的部署时才需要显式指定。
#GOK_TRUST_PROXY=1

# 同一 client 重复查同一个 QQ 时的响应冷却，毫秒。只用来防抖（客户端本地也是短缓存），
# 0 = 关闭
#GOK_READ_COOLDOWN_MS=10000

# 单个来源 IP 的请求额度。挡扫描器用的，不参与授权。
# 多个 bot 挤在同一个 NAT 或反代后面时它们共用一个 IP，那种部署要调大
#GOK_IP_RATE_PER_MINUTE=120
#GOK_IP_BURST=60
